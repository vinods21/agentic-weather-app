{
  "openapi": "3.0.3",
  "info": {
    "title": "agentic-weather-app API",
    "version": "1.0.0",
    "description": "Weather and saved-favourites API for the UI.\n\nCompatibility policy: v1 is additive-only. New fields, error codes and optional parameters may be added; nothing is removed or renamed. Clients MUST ignore unknown response fields. Breaking changes go to /api/v2.\n\nConventions: JSON property names are camelCase, timestamps are ISO-8601 UTC ending in Z, dates are YYYY-MM-DD. Unknown query parameters and unknown request-body properties are ignored. An empty days= value is treated as absent (default 5); an empty units= value is invalid.\n\nErrors: every failure under /api/ is an RFC 9457 Problem Details body (application/problem+json) with a stable machine-readable code. A method that is not supported on an existing path returns 405 METHOD_NOT_ALLOWED with an Allow header; an unknown path under /api/ returns 404 NOT_FOUND.\n\nRequest id: send X-Request-Id (matching ^[A-Za-z0-9._-]{1,64}$) to correlate requests; it is echoed back. A missing or invalid value is replaced by a server-generated UUID. Every response carries the header, and error bodies repeat it in requestId.\n\nClient id: the /api/v1/favourites operations require an X-Client-Id header (matching ^[A-Za-z0-9._-]{1,64}$). It is an opaque partition key generated by the client (e.g. a random UUID kept in local storage), not authentication: anyone who knows an id can read and change its favourites. A missing or invalid value is 400 VALIDATION_FAILED with an error on field X-Client-Id; it is never replaced.\n\nRequest bodies: send Content-Type: application/json; any other content type is 415. A body that is missing, is not valid JSON or does not match the request schema's JSON types is 400 VALIDATION_FAILED with one error on field body. Strings are stripped before validation, and length limits apply to the stripped value. Optional response properties without a value are omitted.\n\nCORS: allowed origins are configured by the operator (deny-by-default). Allowed methods are GET, POST, PUT, PATCH, DELETE and OPTIONS, no credentials; X-Request-Id and Location are exposed."
  },
  "servers": [
    { "url": "/" }
  ],
  "paths": {
    "/api/v1/weather/current": {
      "get": {
        "operationId": "getCurrentWeather",
        "summary": "Current weather for a city",
        "tags": ["weather"],
        "parameters": [
          { "$ref": "#/components/parameters/City" },
          { "$ref": "#/components/parameters/Units" },
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "responses": {
          "200": {
            "description": "Current weather in the requested units.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CurrentWeather" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/LocationNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/UpstreamUnavailable" }
        }
      }
    },
    "/api/v1/weather/forecast": {
      "get": {
        "operationId": "getForecast",
        "summary": "Daily forecast for a city",
        "tags": ["weather"],
        "parameters": [
          { "$ref": "#/components/parameters/City" },
          { "$ref": "#/components/parameters/Units" },
          { "$ref": "#/components/parameters/Days" },
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "responses": {
          "200": {
            "description": "Daily forecast starting at today's UTC date, ascending, no gaps, one entry per requested day.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Forecast" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/LocationNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/UpstreamUnavailable" }
        }
      }
    },
    "/api/v1/favourites": {
      "get": {
        "operationId": "listFavourites",
        "summary": "List the client's favourites in list order",
        "description": "Returns every favourite of the client (at most the configured maximum per client, no pagination). Query parameters are ignored.",
        "tags": ["favourites"],
        "parameters": [
          { "$ref": "#/components/parameters/ClientId" },
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "responses": {
          "200": {
            "description": "The client's favourites in list order (empty if there are none).",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FavouriteList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "post": {
        "operationId": "createFavourite",
        "summary": "Save a city as a favourite",
        "description": "Resolves the city through the weather provider and stores the resolved location. A city whose normalised form (case, whitespace and Unicode normalisation) is already saved by this client is a duplicate; duplicates and the per-client limit are checked before the provider is called. The new favourite goes at the end of the list.",
        "tags": ["favourites"],
        "parameters": [
          { "$ref": "#/components/parameters/ClientId" },
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateFavouriteRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created favourite.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" },
              "Location": { "$ref": "#/components/headers/Location" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Favourite" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/LocationNotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/UpstreamUnavailable" }
        }
      }
    },
    "/api/v1/favourites/{id}": {
      "parameters": [
        { "$ref": "#/components/parameters/FavouriteId" }
      ],
      "get": {
        "operationId": "getFavourite",
        "summary": "Get one favourite",
        "tags": ["favourites"],
        "parameters": [
          { "$ref": "#/components/parameters/ClientId" },
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "responses": {
          "200": {
            "description": "The favourite.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Favourite" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/FavouriteNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "patch": {
        "operationId": "updateFavourite",
        "summary": "Set or clear a favourite's label",
        "description": "Only the label can change; other body properties are ignored, and the city and location never change. updatedAt is set to the current time.",
        "tags": ["favourites"],
        "parameters": [
          { "$ref": "#/components/parameters/ClientId" },
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateFavouriteRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated favourite.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Favourite" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/FavouriteNotFound" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "delete": {
        "operationId": "deleteFavourite",
        "summary": "Delete a favourite",
        "tags": ["favourites"],
        "parameters": [
          { "$ref": "#/components/parameters/ClientId" },
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "responses": {
          "204": {
            "description": "Deleted. No body.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/FavouriteNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/favourites/order": {
      "put": {
        "operationId": "reorderFavourites",
        "summary": "Reorder the client's favourites",
        "description": "ids must list every favourite id of the client exactly once, in the new order; otherwise 400 VALIDATION_FAILED with an error on field ids and the order is unchanged. createdAt and updatedAt are not changed.",
        "tags": ["favourites"],
        "parameters": [
          { "$ref": "#/components/parameters/ClientId" },
          { "$ref": "#/components/parameters/RequestId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReorderFavouritesRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The client's favourites in the new order.",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FavouriteList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "City": {
        "name": "city",
        "in": "query",
        "required": true,
        "description": "City name. Surrounding whitespace is removed; the result must be 1 to 100 characters. Matching is case-insensitive.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 100 },
        "example": "London"
      },
      "Units": {
        "name": "units",
        "in": "query",
        "required": false,
        "description": "metric = deg C and m/s; imperial = deg F and mph. Case-sensitive.",
        "schema": { "type": "string", "enum": ["metric", "imperial"], "default": "metric" }
      },
      "Days": {
        "name": "days",
        "in": "query",
        "required": false,
        "description": "Number of forecast days. Accepted form: optional surrounding whitespace, then an optional + or - sign and ASCII digits 0-9 only (e.g. 3, 03, +3); any other form (non-ASCII digits, hex, decimals, exponents) is 400 VALIDATION_FAILED. An empty value is treated as absent.",
        "schema": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 7, "default": 5 }
      },
      "RequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": false,
        "description": "Client correlation id. Echoed if valid, otherwise replaced by a server-generated UUID.",
        "schema": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$", "maxLength": 64 }
      },
      "ClientId": {
        "name": "X-Client-Id",
        "in": "header",
        "required": true,
        "description": "Opaque client-generated partition key of the favourites list (not authentication). Case-sensitive, never stripped. A missing or invalid value is 400 VALIDATION_FAILED (field X-Client-Id).",
        "schema": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$", "maxLength": 64 },
        "example": "0b6f2c9e-3a1d-4c8e-9f12-5d7a8b9c0e1f"
      },
      "FavouriteId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Favourite id (UUID). A value that is not a UUID is 400 VALIDATION_FAILED (field id); note that \"order\" is not an id, so GET, PATCH and DELETE on /api/v1/favourites/order are 400. Another client's id is 404 NOT_FOUND, the same as a missing one.",
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "headers": {
      "XRequestId": {
        "description": "The request's correlation id (echoed client value or a generated UUID).",
        "schema": { "type": "string" }
      },
      "Location": {
        "description": "Relative URI of the created favourite, /api/v1/favourites/{id}.",
        "schema": { "type": "string", "format": "uri-reference" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "VALIDATION_FAILED: one or more query parameters, path parameters, headers or the request body are missing or invalid. All violations are listed in errors.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "LocationNotFound": {
        "description": "LOCATION_NOT_FOUND: the provider has no data for the requested city.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "FavouriteNotFound": {
        "description": "NOT_FOUND: the client has no favourite with this id (another client's id counts as missing).",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "Conflict": {
        "description": "FAVOURITE_ALREADY_EXISTS: the client already saved this city (same normalised name). FAVOURITES_LIMIT_REACHED: the client already has the configured maximum number of favourites.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "The request body is not application/json. The body follows the framework default and has no code.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
        }
      },
      "InternalError": {
        "description": "INTERNAL_ERROR: an unexpected server error.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "UpstreamUnavailable": {
        "description": "UPSTREAM_UNAVAILABLE: the weather provider failed or timed out. Retry later.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      }
    },
    "schemas": {
      "Location": {
        "type": "object",
        "required": ["name", "country", "latitude", "longitude"],
        "properties": {
          "name": { "type": "string", "description": "Canonical city name.", "example": "London" },
          "country": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2 code.", "example": "GB" },
          "latitude": { "type": "number", "format": "double", "minimum": -90, "maximum": 90, "example": 51.5074 },
          "longitude": { "type": "number", "format": "double", "minimum": -180, "maximum": 180, "example": -0.1278 }
        }
      },
      "Condition": {
        "type": "object",
        "required": ["code", "description"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["CLEAR", "PARTLY_CLOUDY", "CLOUDY", "FOG", "DRIZZLE", "RAIN", "SNOW", "THUNDERSTORM"]
          },
          "description": { "type": "string", "description": "Human-readable text (English, not localised).", "example": "Overcast clouds" }
        }
      },
      "CurrentWeather": {
        "type": "object",
        "required": ["location", "observedAt", "units", "temperature", "feelsLike", "humidity", "windSpeed", "windDirection", "condition"],
        "properties": {
          "location": { "$ref": "#/components/schemas/Location" },
          "observedAt": { "type": "string", "format": "date-time", "description": "ISO-8601 UTC timestamp ending in Z.", "example": "2026-11-15T10:00:00Z" },
          "units": { "type": "string", "enum": ["metric", "imperial"] },
          "temperature": { "type": "number", "format": "double", "description": "deg C (metric) or deg F (imperial).", "example": 11.2 },
          "feelsLike": { "type": "number", "format": "double", "description": "deg C (metric) or deg F (imperial).", "example": 9.8 },
          "humidity": { "type": "integer", "format": "int32", "minimum": 0, "maximum": 100, "description": "Relative humidity in percent.", "example": 81 },
          "windSpeed": { "type": "number", "format": "double", "minimum": 0, "description": "m/s (metric) or mph (imperial).", "example": 4.1 },
          "windDirection": { "type": "integer", "format": "int32", "minimum": 0, "maximum": 359, "description": "Degrees.", "example": 230 },
          "condition": { "$ref": "#/components/schemas/Condition" }
        }
      },
      "ForecastDay": {
        "type": "object",
        "required": ["date", "minTemperature", "maxTemperature", "precipitationProbability", "condition"],
        "properties": {
          "date": { "type": "string", "format": "date", "example": "2026-11-15" },
          "minTemperature": { "type": "number", "format": "double", "description": "deg C (metric) or deg F (imperial).", "example": 6.0 },
          "maxTemperature": { "type": "number", "format": "double", "description": "deg C (metric) or deg F (imperial).", "example": 12.5 },
          "precipitationProbability": { "type": "integer", "format": "int32", "minimum": 0, "maximum": 100, "description": "Percent.", "example": 40 },
          "condition": { "$ref": "#/components/schemas/Condition" }
        }
      },
      "Forecast": {
        "type": "object",
        "required": ["location", "units", "days"],
        "properties": {
          "location": { "$ref": "#/components/schemas/Location" },
          "units": { "type": "string", "enum": ["metric", "imperial"] },
          "days": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "items": { "$ref": "#/components/schemas/ForecastDay" }
          }
        }
      },
      "Favourite": {
        "type": "object",
        "required": ["id", "city", "location", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "example": "0b6f2c9e-3a1d-4c8e-9f12-5d7a8b9c0e1f" },
          "city": { "type": "string", "minLength": 1, "maxLength": 100, "description": "The city as sent on create (stripped). Pass it to /api/v1/weather/* as city.", "example": "london" },
          "label": { "type": "string", "minLength": 1, "maxLength": 50, "description": "Optional short label; omitted when not set.", "example": "Home" },
          "location": { "$ref": "#/components/schemas/Location" },
          "createdAt": { "type": "string", "format": "date-time", "description": "ISO-8601 UTC timestamp ending in Z.", "example": "2026-11-15T10:00:00Z" },
          "updatedAt": { "type": "string", "format": "date-time", "description": "ISO-8601 UTC timestamp ending in Z; changes when the label changes, not on reorder.", "example": "2026-11-15T10:00:00Z" }
        }
      },
      "FavouriteList": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "description": "The client's favourites in list order.",
            "items": { "$ref": "#/components/schemas/Favourite" }
          }
        }
      },
      "CreateFavouriteRequest": {
        "type": "object",
        "required": ["city"],
        "properties": {
          "city": { "type": "string", "minLength": 1, "maxLength": 100, "description": "City name, the same rules as the weather endpoints' city parameter (stripped, 1 to 100 characters).", "example": "London" },
          "label": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 50, "description": "Optional label (stripped, 1 to 50 characters). Missing or null means no label.", "example": "Home" }
        }
      },
      "UpdateFavouriteRequest": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 50, "description": "New label (stripped, 1 to 50 characters); null clears the label. The property must be present.", "example": "Work" }
        }
      },
      "ReorderFavouritesRequest": {
        "type": "object",
        "required": ["ids"],
        "properties": {
          "ids": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "description": "Every favourite id of the client exactly once, in the new order.",
            "items": { "type": "string", "format": "uuid" }
          }
        }
      },
      "FieldError": {
        "type": "object",
        "required": ["field", "message"],
        "properties": {
          "field": { "type": "string", "description": "Name of the invalid query parameter, path parameter, request header (e.g. X-Client-Id) or body property (e.g. city, ids), or body when the request body cannot be read.", "example": "city" },
          "message": { "type": "string", "example": "must not be blank" }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 Problem Details with a stable code and the request id.",
        "required": ["type", "title", "status", "detail", "instance", "code", "requestId"],
        "properties": {
          "type": { "type": "string", "format": "uri", "description": "Problem type identifier (need not resolve).", "example": "https://weather.example.com/problems/validation-failed" },
          "title": { "type": "string", "example": "Validation failed" },
          "status": { "type": "integer", "format": "int32", "example": 400 },
          "detail": { "type": "string", "example": "One or more request parameters are invalid." },
          "instance": { "type": "string", "format": "uri-reference", "description": "Request path.", "example": "/api/v1/weather/current" },
          "code": {
            "type": "string",
            "enum": ["VALIDATION_FAILED", "LOCATION_NOT_FOUND", "NOT_FOUND", "METHOD_NOT_ALLOWED", "UPSTREAM_UNAVAILABLE", "INTERNAL_ERROR", "FAVOURITE_ALREADY_EXISTS", "FAVOURITES_LIMIT_REACHED"]
          },
          "requestId": { "type": "string", "example": "3f2b1c9e-8d7a-4f3e-9b1a-2c4d6e8f0a1b" },
          "errors": {
            "type": "array",
            "description": "Present only for VALIDATION_FAILED.",
            "items": { "$ref": "#/components/schemas/FieldError" }
          }
        }
      }
    }
  }
}
