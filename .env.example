# Copy to .env (scripts/test-env.sh does this automatically if .env is missing).
# .env is git-ignored. These are local-development values only.
POSTGRES_DB=weather
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather-local-dev
POSTGRES_PORT=5432
REDIS_PORT=6379
APP_PORT=8080
# CORS allow-list for /api/** (comma-separated). Empty/unset = deny every origin.
# Left commented on purpose: build.gradle.kts exports this file into integration tests.
# WEATHER_API_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Weather provider (ADR 0005/0006). Unset = defaults from application.yml.
# Left commented on purpose: build.gradle.kts exports this file into integration tests.
# Keep HTTPS base URLs in production; http is only for local fakes.
# Provider: stub (fixed offline data) | open-meteo (default, needs outbound internet).
# WEATHER_PROVIDER=stub
# Open-Meteo geocoding API base URL (scheme + host, no path).
# WEATHER_PROVIDER_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
# Open-Meteo forecast API base URL (scheme + host, no path).
# WEATHER_PROVIDER_FORECAST_BASE_URL=https://api.open-meteo.com
# Connect timeout per upstream call.
# WEATHER_PROVIDER_CONNECT_TIMEOUT=2s
# Read timeout per upstream call.
# WEATHER_PROVIDER_READ_TIMEOUT=3s
